{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HarNova Studio",
  "version": "1.0.0",
  "identifier": "my.harnova.studio",
  "build": {
    "frontendDist": "../../_desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && bash ../studio/build.sh desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HarNova Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "NetLab network simulator and HarNova Canvas diagrams",
    "longDescription": "HarNova Studio brings together NetLab, an open-source network simulator, and HarNova Canvas, a diagram editor based on draw.io, in one offline app for students.",
    "copyright": "\u00a9 2026 HarNova Technology. NetLab: MIT. HarNova Canvas: based on draw.io, Apache License 2.0.",
    "publisher": "HarNova Technology",
    "homepage": "https://studio.harnova.my",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
