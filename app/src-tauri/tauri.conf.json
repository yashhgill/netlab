{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetLab",
  "version": "1.0.0",
  "identifier": "my.harnova.netlab",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetLab",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Open-source network simulator",
    "longDescription": "Build networks of routers, switches and PCs, configure them with an IOS-style command line, and watch every packet in simulation mode.",
    "copyright": "© 2026 HarNova Technology. MIT licensed.",
    "publisher": "HarNova Technology",
    "homepage": "https://netlab.harnova.my",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
